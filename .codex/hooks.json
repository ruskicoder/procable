{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".codex/skills/procable/scripts/procable\" ] || \".codex/skills/procable/scripts/procable\" hook",
            "commandWindows": "cmd /c if exist \".codex\\skills\\procable\\scripts\\procable.cmd\" \".codex\\skills\\procable\\scripts\\procable.cmd\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".codex/skills/procable/scripts/procable\" ] || \".codex/skills/procable/scripts/procable\" hook",
            "commandWindows": "cmd /c if exist \".codex\\skills\\procable\\scripts\\procable.cmd\" \".codex\\skills\\procable\\scripts\\procable.cmd\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
