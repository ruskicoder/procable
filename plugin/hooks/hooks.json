{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PLUGIN_ROOT}/skills/procable/scripts/procable\" ] || sh \"${CLAUDE_PLUGIN_ROOT}/skills/procable/scripts/procable\" hook",
            "windows": "cmd /c if exist ${CLAUDE_PLUGIN_ROOT}\\skills\\procable\\scripts\\procable.cmd ${CLAUDE_PLUGIN_ROOT}\\skills\\procable\\scripts\\procable.cmd hook",
            "env": {
              "PROCABLE_HOOK_HARNESS": "vscode"
            },
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PLUGIN_ROOT}/skills/procable/scripts/procable\" ] || sh \"${CLAUDE_PLUGIN_ROOT}/skills/procable/scripts/procable\" hook",
            "windows": "cmd /c if exist ${CLAUDE_PLUGIN_ROOT}\\skills\\procable\\scripts\\procable.cmd ${CLAUDE_PLUGIN_ROOT}\\skills\\procable\\scripts\\procable.cmd hook",
            "env": {
              "PROCABLE_HOOK_HARNESS": "vscode"
            },
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PLUGIN_ROOT}/skills/procable/scripts/procable\" ] || sh \"${CLAUDE_PLUGIN_ROOT}/skills/procable/scripts/procable\" hook",
            "windows": "cmd /c if exist ${CLAUDE_PLUGIN_ROOT}\\skills\\procable\\scripts\\procable.cmd ${CLAUDE_PLUGIN_ROOT}\\skills\\procable\\scripts\\procable.cmd hook",
            "env": {
              "PROCABLE_HOOK_HARNESS": "vscode"
            },
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
